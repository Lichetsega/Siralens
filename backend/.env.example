# --- Supabase ---
SUPABASE_URL=https://cwuj....
# Only needed if your project still uses the legacy HS256 JWT secret.
# New projects use asymmetric signing keys (verified through the JWKS endpoint) and need no secret here.
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated

# --- Database (Supabase -> Project Settings -> Database -> Connection string -> Session pooler) ---
DATABASE_URL=postgresql://postgres.cwuj.....

# --- App ---
CORS_ORIGINS=http://localhost:3000
ENVIRONMENT=development
